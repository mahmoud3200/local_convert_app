{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LoConvert",
  "version": "1.0.0-beta",
  "identifier": "app.localconvert.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run ffmpeg:setup && npm run dev",
    "beforeBuildCommand": "npm run ffmpeg:setup && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LoConvert",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "maximized": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg"],
    "windows": {
      "wix": {
        "version": "1.0.0.1"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
